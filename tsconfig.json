{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "outDir": "dist",
    "paths": {
      "#models/*": [
        "./src/models/*"
      ],
      "#generators/*": [
        "./src/generators/*"
      ],
      "#core/*": [
        "./src/core/*"
      ],
      "#data/*": [
        "./src/data/*"
      ],
      "#simulation/*": [
        "./src/simulation/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}